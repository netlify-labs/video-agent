{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract": {
      "type": "number",
      "const": 1
    },
    "width": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "height": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "fps": {
      "type": "number",
      "const": 30
    },
    "colors": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "beats": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "duration": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 120
          },
          "authoredDuration": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 120
          },
          "texts": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "maxLength": 500
                },
                "label": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "text",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "media": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "image",
                    "video"
                  ]
                },
                "src": {
                  "type": "string",
                  "pattern": "^assets\\/media\\/[A-Za-z0-9_.-]+$"
                },
                "fit": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "cover",
                        "contain"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "label": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "hasAudio": {
                  "type": "boolean"
                }
              },
              "required": [
                "kind",
                "src",
                "fit",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "voice": {
            "type": "null"
          },
          "sfx": {
            "type": "array",
            "prefixItems": [],
            "items": false,
            "maxItems": 0
          }
        },
        "required": [
          "id",
          "label",
          "duration",
          "authoredDuration",
          "texts",
          "media",
          "voice",
          "sfx"
        ],
        "additionalProperties": false
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "music": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "label": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "src": {
                  "type": "string",
                  "pattern": "^assets\\/(media|music)\\/[A-Za-z0-9_.-]+$"
                },
                "volume": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 4
                },
                "muted": {
                  "type": "boolean"
                },
                "fadeIn": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "fadeOut": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                }
              },
              "required": [
                "id",
                "label",
                "src",
                "volume",
                "muted",
                "fadeIn",
                "fadeOut"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "music"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract",
    "width",
    "height",
    "fps",
    "colors",
    "layers",
    "beats",
    "audio"
  ],
  "additionalProperties": false
}
