{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src", "netlify/functions", "scripts", "docs/spikes", "test", "drizzle.config.ts", "vitest.config.ts", "playwright.config.ts", "ui/e2e"],
  "exclude": ["docs/spikes/s10/web", "docs/spikes/e3", "docs/spikes/e4", "docs/spikes/e5"]
}
