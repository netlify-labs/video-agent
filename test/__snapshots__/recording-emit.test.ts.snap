// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`recording.ts emit > emits each golden step: snapshot, valid under the contract, data files in their grammar > step-1 1`] = `
"<section id="step-1" class="clip va-rec-scene" data-va-beat="step-1" data-va-label="step-1" data-composition-id="step-1" data-start="0" data-duration="10" data-va-authored-duration="10" data-track-index="0">
  <script src="assets/recording/redact.js"></script>
  <script src="assets/recording/step-1.cursor.js"></script>
  <div class="va-recording" data-va-recording="step-1" data-va-frame="wallpaper">
    <div class="va-stage" data-va-camera='[[0,0.5,0.5,1],[2.5,0.5,0.5,1],[3.5,0.3,0.3,2.2,"power2.inOut"],[4.6,0.3,0.3,2.2],[5.6,0.5,0.5,1,"power2.inOut"],[10,0.5,0.5,1]]'>
      <video id="rec-step-1" data-va-media="step-1-screen" data-va-kind="video" data-va-label="Screen" src="assets/media/med_golden.mp4" data-va-in="0" data-va-out="10" data-media-start="0" data-playback-rate="1" muted data-start="0" data-duration="10"></video>
      <div class="va-cursor" data-va-cursor="smooth" data-va-path="step-1"></div>
      <div class="va-clicks" data-va-clicks='[[4,0.3,0.3]]'></div>
      <div class="va-redact" data-va-redact='[]' data-va-locked="assets/recording/redact.js"></div>
    </div>
  </div>
  <p class="va-callout" data-va-text="step-1-callout" data-va-label="Callout">Describe this step</p>
  <script>
    vaBeat('step-1', (tl, el) => {
      vaRecording(tl, el)
      tl.from(el.querySelector('[data-va-text="step-1-callout"]'), { opacity: 0, y: 12, duration: 0.4 }, 0.6)
    })
  </script>
</section>"
`;

