{
  "name": "video-agent",
  "version": "0.0.0",
  "private": true,
  "description": "A Netlify template that turns a prompt into a video with Agent Runners and HyperFrames",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit",
    "lint": "NODE_OPTIONS=--max-old-space-size=6144 eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "openapi:gen": "tsx scripts/gen-openapi.ts && npx -y openapi-typescript@7.13.0 openapi.json -o ui/src/api/schema.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "build": "tsx scripts/build.ts",
    "build:ui": "vite build ui",
    "setup": "tsx scripts/setup.ts",
    "setup:openverse": "tsx scripts/setup-openverse.ts",
    "postinstall": "netlify-agent-kit install --strict",
    "openapi:check": "tsx scripts/gen-openapi.ts --check && npx -y openapi-typescript@7.13.0 openapi.json --check -o ui/src/api/schema.d.ts",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@hono/netlify": "1.0.2",
    "@hono/zod-openapi": "1.6.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@netlify/blobs": "11.1.7",
    "@netlify/database": "2.0.1",
    "@netlify/functions": "6.0.3",
    "@netlify/identity": "2.0.0",
    "@typesafe-ai/sdk": "0.7.0",
    "drizzle-orm": "1.0.0-beta.22",
    "hono": "4.13.14",
    "nax-agent-runner-sdk": "0.3.0",
    "parse5": "7.3.0",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.17",
    "@eslint/js": "10.0.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@mantine/core": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@mantine/modals": "9.7.4",
    "@mantine/notifications": "9.7.4",
    "@netlify/edge-functions": "4.0.3",
    "@playwright/test": "1.64.1",
    "@scalar/api-reference-react": "0.9.87",
    "@tabler/icons-react": "3.50.0",
    "@tanstack/react-query": "5.105.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "1.0.0-beta.22",
    "eslint": "10.14.0",
    "hyperframes": "0.8.222",
    "netlify-agent-kit": "0.4.0",
    "openapi-fetch": "0.17.0",
    "openapi-react-query": "0.5.4",
    "postcss": "8.5.32",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "netlifyAgent": {
    "hyperframes": {
      "version": "0.8.222",
      "dir": "video"
    },
    "files": [
      {
        "from": {
          "env": "BRAND_ZIP_URL"
        },
        "to": "context/brand",
        "optional": true
      }
    ]
  }
}
